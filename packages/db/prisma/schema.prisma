generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id              String   @id // Maps to Firebase UID
  email           String   @unique
  displayName     String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     WorkspaceMember[]
  comments        Comment[]
  mentions        Mention[]
  notifications   Notification[]
  assignedIssues  Issue[]            @relation("IssueAssignee")
  authoredIssues  Issue[]            @relation("IssueAuthor")
  auditLogs       AuditLog[]
  fileAssets      FileAsset[]
  createdResources Resource[]
  revisions       Revision[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]
  auditLogs   AuditLog[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  workspaceId String
  email       String
  token       String           @unique
  role        Role
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages     Page[]
  files     FileAsset[]
  issues    Issue[]
  resources Resource[]

  @@index([workspaceId])
}

enum ResourceType {
  FOLDER
  PAGE
  FILE
}

model Resource {
  id        String       @id @default(uuid())
  projectId String
  parentId  String?
  name      String
  type      ResourceType
  position  Float        @default(0)
  isDeleted Boolean      @default(false)
  createdBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Resource?    @relation("ResourceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Resource[]   @relation("ResourceHierarchy")
  author    User         @relation(fields: [createdBy], references: [id])

  page         Page?
  fileAsset    FileAsset?
  fileSnapshot FileSnapshot?
  revisions    Revision[]

  @@index([projectId])
  @@index([parentId])
}

model Page {
  id          String   @id @default(uuid())
  projectId   String
  parentId    String?
  title       String
  resourceId  String?  @unique
  content     Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Page?      @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Page[]     @relation("PageHierarchy")
  resource  Resource?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  snapshots DocumentSnapshot[]
  comments  Comment[]
  mentions  Mention[]

  @@index([projectId])
}

model DocumentSnapshot {
  id        String   @id @default(uuid())
  pageId    String
  state     Bytes
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model FileSnapshot {
  id         String   @id @default(uuid())
  resourceId String   @unique
  state      Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model Revision {
  id              String   @id @default(uuid())
  resourceId      String
  authorId        String
  stateSnapshot   Bytes?   // For Yjs states (Pages and Code/Text Files)
  fileAssetId     String?  // Reference to physical file if this is a binary upload
  versionNumber   Int
  message         String?
  size            Int
  createdAt       DateTime @default(now())

  resource        Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([resourceId, versionNumber])
  @@index([resourceId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  pageId    String
  authorId  String
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Mention {
  id        String   @id @default(uuid())
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String        @id @default(uuid())
  projectId   String
  authorId    String
  assigneeId  String?
  title       String
  description String?
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  linkedSnippet String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User    @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignee User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model FileAsset {
  id          String   @id @default(uuid())
  projectId   String
  resourceId  String?  @unique
  uploaderId  String
  filename    String
  path        String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  resource Resource?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  revisions Revision[]

  @@index([projectId])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String?
  action      String
  resource    String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}
